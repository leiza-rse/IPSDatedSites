@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmdig: <http://www.ics.forth.gr/isl/CRMdig/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix lado: <http://archaeology.link/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lado:DatingActivity a owl:Class ;
    rdfs:label "Dating activity"@en ;
    rdfs:comment "Der Rechenlauf, der eine Datierung erzeugt hat. Haengt an crmdig:D10_Software_Execution, weil dessen Scope Note genau das beschreibt: ein Lauf, der vollstaendig durch seine digitale Eingabe, die Software und die Eigenschaften der Maschine bestimmt ist. CRMdig hat die Ausrichtung auf CIDOC CRM bereits gemacht, ueber D7 und E11/E65 bis E7_Activity — das ist tragfaehiger, als selbst zu entscheiden, ob ein Skriptlauf eine E7_Activity ist."@de,
        "The computation that produced one dating. It sits beneath crmdig:D10_Software_Execution, whose scope note describes precisely this: a run completely determined by its digital input, the software and the generic properties of the device. Using CRMdig rather than reaching for crm:E7_Activity directly means the alignment has been done by the extension's authors — D10 leads through D7 and E11/E65 to E7_Activity — instead of this vocabulary deciding on its own whether a script run counts as an action intentionally carried out by an actor."@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:subClassOf crmdig:D10_Software_Execution,
        prov:Activity .

lado:DatingInstant a owl:Class ;
    rdfs:label "Dating instant"@en ;
    rdfs:comment "Eine Intervallgrenze. Eigene Anwendungsklasse, damit sie in CIDOC CRM verankert werden kann, ohne eine Behauptung ueber time:Instant im Allgemeinen aufzustellen: crm:E52_Time-Span ist der CRM-Begriff fuer eine zeitliche Ausdehnung, hier eine von der Dauer null."@de,
        "One boundary of a dated interval. A local class rather than a bare time:Instant so that it can be anchored in CIDOC CRM without making any claim about time:Instant in general: crm:E52_Time-Span is the CRM notion of a temporal extent, and this one has zero duration. Every instance of an application class in this export reaches CIDOC CRM, and the boundaries are no exception — without the anchor a CRM-only consumer would see a time-span whose ends did not exist."@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:subClassOf crm:E52_Time-Span,
        time:Instant .

lado:DatingTimePosition a owl:Class ;
    rdfs:label "Dating time position"@en ;
    rdfs:comment "Die Zahlenangabe einer Intervallgrenze auf einer benannten Skala. Strukturell eine crm:E54_Dimension: ein Wert plus das System, in dem er zu lesen ist — time:numericPosition entspricht P90 has value, time:hasTRS entspricht P91 has unit."@de,
        "The numeric value of a boundary together with the scale it is read on. Structurally a crm:E54_Dimension: time:numericPosition corresponds to P90 has value and time:hasTRS to P91 has unit. Kept as a local subclass so the alignment is stated here rather than asserted about OWL-Time itself."@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:subClassOf crm:E54_Dimension,
        time:TimePosition .

lado:DiscoverySite a owl:Class ;
    rdfs:label "Discovery site"@en ;
    rdfs:comment "Bestehende LADO-Klasse aus loc_discoverysite_1.ttl."@de,
        "An existing LADO class from the published loc_discoverysite dataset. This export references such nodes; it never re-types or redefines them."@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:subClassOf lado:Location .

lado:FindspotDating a owl:Class ;
    rdfs:label "Findspot dating"@en ;
    rdfs:comment "Datierung einer Fundstelle aus Toepferstempeln. Das Intervall ist ein 'virtual fuzzy year' m +/- k*sigma, KEIN Konfidenzintervall."@de,
        "The dating of one findspot derived from samian potters' stamps. The interval is a 'virtual fuzzy year' of the form m ± k·σ and is explicitly NOT a confidence interval: it carries no probabilistic claim about where the true date lies."@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:subClassOf lado:DatedTimeSpan .

lado:YearScale a owl:Class ;
    rdfs:label "Year scale"@en ;
    rdfs:comment "Das Zeitreferenzsystem, auf dem die Zahlenangaben liegen. Eine dokumentierte Konvention und damit ein crm:E73_Information_Object."@de,
        "The temporal reference system the numeric positions are read on. A documented convention, and therefore a crm:E73_Information_Object. Its definition matters because the positions are signed years on a continuous line, not calendar labels — see eraConvention."@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:subClassOf crm:E73_Information_Object,
        time:TRS .

lado:avgDatemax a owl:DatatypeProperty ;
    rdfs:label "average datemax"@en ;
    rdfs:comment "Mean of the contributing potters' end dates."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:avgDatemin a owl:DatatypeProperty ;
    rdfs:label "average datemin"@en ;
    rdfs:comment "Mean of the contributing potters' start dates."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:bandPadding a owl:DatatypeProperty ;
    rdfs:label "band padding"@en ;
    rdfs:comment "Fraction of each row left empty between bars, following the d3.scaleBand convention."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:calibratedAgainst a owl:ObjectProperty ;
    rdfs:label "calibrated against"@en ;
    rdfs:comment "A findspot whose date is known independently of samian ware, used to fix the coverage factor. Naming them in the graph is the point: a calibration whose reference set is not published cannot be checked."@de,
        "A findspot whose date rests on dendrochronology, coins or a historical event rather than on samian ware. Naming them in the graph is the point: a calibration whose reference set is not published cannot be checked, and one calibrated against samian-dated ensembles would be circular. Two candidates were dropped for exactly that reason."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:Findspot .

lado:calibrationBasis a owl:DatatypeProperty ;
    rdfs:label "calibration basis"@en ;
    rdfs:comment "How the coverage factor was obtained. A plain-language statement, not a machine-readable procedure: it says which criterion was applied so that a reader can judge the number rather than take it on trust."@de,
        "How the coverage factor was arrived at, in words. The value of tau was not chosen for elegance: it is the smallest value at which every reference findspot's terminus ante quem still falls inside its interval. k_min and k_max remain set conventions, because five reference ensembles cannot separate three parameters — attempting it produced 2 424 parameter combinations that fit the data equally well."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:colourRamp a owl:DatatypeProperty ;
    rdfs:label "colour ramp"@en ;
    rdfs:comment "Name of the colour ramp mapping quality to colour, recorded so that a reader can reproduce the fill colours rather than eyeballing them."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:colourSource a owl:ObjectProperty ;
    rdfs:label "colour source"@en ;
    rdfs:comment "Die gemessene Eigenschaft, aus der diese Achse ihre Werte nimmt."@de,
        "The measured property an axis takes its values from. Following it leads from the colour back to the evidence."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range rdf:Property .

lado:dieRepetition a owl:DatatypeProperty ;
    rdfs:label "die repetition"@en ;
    rdfs:comment "nStampsWithDie / nDies. Depot-Indikator."@de,
        "nStampsWithDie divided by nDies. High values indicate that the same dies recur, which is characteristic of a hoard or a closed deposit rather than of accumulated site refuse."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:domainBasis a owl:DatatypeProperty ;
    rdfs:label "domain basis"@en ;
    rdfs:comment "'fixed': gesetzte Konvention, bleibt bei wachsendem Korpus stehen. 'observed': aus diesem Korpus gelesen — kommen Fundstellen hinzu, verschieben sich die Farben auch der unveraenderten."@de,
        "Whether the domain is a fixed convention or was observed in this corpus. The distinction matters for anyone comparing two snapshots: an observed domain moves when findspots are added, so an unchanged findspot can change colour without its dating having changed at all."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:domainMax a owl:DatatypeProperty ;
    rdfs:label "domain maximum"@en ;
    rdfs:comment "Wert, der auf 1 abgebildet wird."@de,
        "The value mapped to the high end of the ramp."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:domainMin a owl:DatatypeProperty ;
    rdfs:label "domain minimum"@en ;
    rdfs:comment "Wert, der auf 0 abgebildet wird."@de,
        "The value mapped to the low end of the ramp. Values below it are clamped rather than dropped."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:domainScale a owl:DatatypeProperty ;
    rdfs:label "domain scale"@en ;
    rdfs:comment "'linear' oder 'log'."@de,
        "Whether values are stretched linearly or logarithmically. Logarithmic where the quantity spans orders of magnitude, so that the ramp is not exhausted by a handful of large sites."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:eraConvention a owl:DatatypeProperty ;
    rdfs:label "era convention"@en ;
    rdfs:comment "Wie negative Jahreszahlen der Quelle zu lesen sind."@de,
        "How negative years in the source are to be read. Under 'historical', −40 means 40 BC, and the derived xsd:gYear label is shifted by one because XSD counts astronomically. Only the calendar label is shifted; the numeric position is left untouched."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:excludedDatemax a owl:DatatypeProperty ;
    rdfs:label "excluded datemax value"@en ;
    rdfs:comment "Filter p.datemax NOT IN (...) aus der Quell-Query. Bedeutung ungeklaert. Der Filter ist nicht neutral: er entfernt die betroffenen Toepfer an ALLEN Fundplaetzen."@de,
        "A datemax value removed by the source query's filter. The reason for the exclusion is not currently documented. The filter is not neutral: it removes the affected potters at every findspot, so it is recorded here rather than left silent."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:extremeStubYears a owl:DatatypeProperty ;
    rdfs:label "extreme stub years"@en ;
    rdfs:comment "Length of the stub drawn at each extreme value. The full range line was replaced by these stubs in the web application, and both figures follow that decision."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:fuzzinessDivisor a owl:DatatypeProperty ;
    rdfs:label "fuzziness divisor"@en ;
    rdfs:comment "12 = Varianz der Gleichverteilung. Die Verteilungsannahme pro Stempel steckt hier."@de,
        "The value 12, being the variance of a uniform distribution over a unit range. This is where the per-stamp distributional assumption enters the model, and stating it makes that assumption inspectable rather than implicit."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:hasColourAxis a owl:ObjectProperty ;
    rdfs:label "has colour axis"@en ;
    rdfs:comment "Verbindet die Abbildung mit einer der Farbachsen, nach denen ihre Zeilen eingefaerbt werden koennen."@de,
        "Relates a figure to a colour axis its rows can be shaded by. A figure carries several, because sharpness, chronology, dispersion and sample size answer different questions and choosing between them belongs to whoever is drawing the map."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:ColourAxis .

lado:hasRow a owl:ObjectProperty ;
    rdfs:label "has row"@en ;
    rdfs:comment "Links a figure to the plot rows it contains."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:PlotRow .

lado:hexMidpointYear a owl:DatatypeProperty ;
    rdfs:label "colour for midpointYear"@en ;
    rdfs:comment "VISUAL ONLY. Der Hexwert zu lado:normMidpointYear auf der Skala samian:axis_midpointYear. Aus dem Graphen nachrechenbar."@de,
        "Presentation only. The colour corresponding to lado:normMidpointYear on the axis samian:axis_midpointYear. Recomputable from that axis's stops and interpolation; carried in the graph so that two maps of the same data cannot disagree about the scale."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:hexNStamps a owl:DatatypeProperty ;
    rdfs:label "colour for nStamps"@en ;
    rdfs:comment "VISUAL ONLY. Der Hexwert zu lado:normNStamps auf der Skala samian:axis_nStamps. Aus dem Graphen nachrechenbar."@de,
        "Presentation only. The colour corresponding to lado:normNStamps on the axis samian:axis_nStamps. Recomputable from that axis's stops and interpolation; carried in the graph so that two maps of the same data cannot disagree about the scale."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:hexProperty a owl:ObjectProperty ;
    rdfs:label "hex property"@en ;
    rdfs:comment "Die Eigenschaft, unter der der Hexwert an der Plotzeile steht."@de,
        "The property under which this axis's colour appears on a plot row. See normalisedProperty for why it is named rather than assumed."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range rdf:Property .

lado:hexQInterval a owl:DatatypeProperty ;
    rdfs:label "colour for qInterval"@en ;
    rdfs:comment "VISUAL ONLY. Der Hexwert zu lado:normQInterval auf der Skala samian:axis_qInterval. Aus dem Graphen nachrechenbar."@de,
        "Presentation only. The colour corresponding to lado:normQInterval on the axis samian:axis_qInterval. Recomputable from that axis's stops and interpolation; carried in the graph so that two maps of the same data cannot disagree about the scale."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:hexSigmaYears a owl:DatatypeProperty ;
    rdfs:label "colour for sigmaYears"@en ;
    rdfs:comment "VISUAL ONLY. Der Hexwert zu lado:normSigmaYears auf der Skala samian:axis_sigmaYears. Aus dem Graphen nachrechenbar."@de,
        "Presentation only. The colour corresponding to lado:normSigmaYears on the axis samian:axis_sigmaYears. Recomputable from that axis's stops and interpolation; carried in the graph so that two maps of the same data cannot disagree about the scale."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:identifierScheme a owl:DatatypeProperty ;
    rdfs:label "identifier scheme"@en ;
    rdfs:comment "Rezept, nach dem die Fundstellen-Fragmente gebildet werden. Muss von jeder weiteren Implementierung zeichengenau reproduziert werden, sonst entstehen abweichende URIs."@de,
        "The recipe by which findspot URI fragments are built. Any further implementation must reproduce it character for character, including the Unicode normalisation step, or it will mint different URIs for the same findspot."@en ;
    rdfs:domain dcat:Dataset ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:intervalLabel a owl:DatatypeProperty ;
    rdfs:label "interval label"@en ;
    rdfs:comment "Textform aus der Query (avg_interval)."@de,
        "The interval rendered as text by the source query, retained for display and for comparison against the published web output."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:kFactor a owl:DatatypeProperty ;
    rdfs:label "k factor"@en ;
    rdfs:comment "k = k_max - (k_max-k_min)*(1-exp(-n/tau)), rein volumenbasiert."@de,
        "The volume-based multiplier applied to sigmaYears. It falls from k_max towards k_min as evidence accumulates, so a findspot with many stamps receives a narrower interval than one with few."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:kMax a owl:DatatypeProperty ;
    rdfs:label "k max"@en ;
    rdfs:comment "Upper bound of the k factor, applied when evidence is thin or absent."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:kMin a owl:DatatypeProperty ;
    rdfs:label "k min"@en ;
    rdfs:comment "Lower bound of the k factor, approached as evidence accumulates."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:kNoDieRecord a owl:DatatypeProperty ;
    rdfs:label "k no die record"@en ;
    rdfs:comment "true = fuer diese Fundstelle liegt keine Stempeltyp-Erfassung vor. Seit 30a ohne Wirkung auf das Intervall: ein Hinweis auf eine Luecke im Datenbestand, kein Modellzustand."@de,
        "True where no die attribution exists at all for the findspot. Up to revision 30a this condition set k to k_max and widened the interval for a reason unconnected with the material; it now has no effect on the dating and records a gap in the die record instead."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:boolean .

lado:marginBottom a owl:DatatypeProperty ;
    rdfs:label "margin bottom"@en ;
    rdfs:comment "Bottom margin, in pixels."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:marginLeft a owl:DatatypeProperty ;
    rdfs:label "margin left"@en ;
    rdfs:comment "Left margin, in pixels; it accommodates the site and findspot labels."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:marginRight a owl:DatatypeProperty ;
    rdfs:label "margin right"@en ;
    rdfs:comment "Right margin, in pixels."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:marginTop a owl:DatatypeProperty ;
    rdfs:label "margin top"@en ;
    rdfs:comment "Top margin, in pixels."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:maxDatemax a owl:DatatypeProperty ;
    rdfs:label "maximum datemax"@en ;
    rdfs:comment "Latest end date among the contributing potters. Drawn as the right extreme stub in both figures."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:maxDatemin a owl:DatatypeProperty ;
    rdfs:label "maximum datemin"@en ;
    rdfs:comment "Latest start date among the contributing potters."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:midpointYear a owl:DatatypeProperty ;
    rdfs:label "midpoint year"@en ;
    rdfs:comment "The centre of the averaged interval, the m in m ± k·σ."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:minDatemax a owl:DatatypeProperty ;
    rdfs:label "minimum datemax"@en ;
    rdfs:comment "Earliest end date among the contributing potters."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:minDatemin a owl:DatatypeProperty ;
    rdfs:label "minimum datemin"@en ;
    rdfs:comment "Earliest start date among the contributing potters. Drawn as the left extreme stub in both figures."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:nDies a owl:DatatypeProperty ;
    rdfs:label "number of dies"@en ;
    rdfs:comment "The number of distinct dies attested at the findspot, counted over the pair (potter, die)."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:nStamps a owl:DatatypeProperty ;
    rdfs:label "number of stamps"@en ;
    rdfs:comment "Anzahl Stempel an der Fundstelle (count_stamps)."@de,
        "The number of stamps recorded at the findspot. Note that this is not the n used by the k formula — see nStampsWithDie."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:nStampsWithDie a owl:DatatypeProperty ;
    rdfs:label "number of stamps with a die"@en ;
    rdfs:comment "ACHTUNG: das n der k-Formel. Zaehlt nur Stempel mit Die-Angabe und ist NICHT nStamps."@de,
        "The number of stamps that carry a die attribution. This is the n in the k formula. It is smaller than nStamps because the underlying query counts only rows where a die is recorded. Substituting nStamps here yields a different k from the one actually used, which is why both are exported."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:normMidpointYear a owl:DatatypeProperty ;
    rdfs:label "normalised midpointYear"@en ;
    rdfs:comment "VISUAL ONLY. lado:midpointYear auf [0,1] gestreckt, nach der Achse samian:axis_midpointYear. Chronological position. A sequential ramp on purpose: red-green would read as a judgement, and late material is not worse material."@de,
        "Presentation only. The value of lado:midpointYear stretched onto the unit interval by the axis samian:axis_midpointYear. Chronological position. A sequential ramp on purpose: red-green would read as a judgement, and late material is not worse material."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:normNStamps a owl:DatatypeProperty ;
    rdfs:label "normalised nStamps"@en ;
    rdfs:comment "VISUAL ONLY. lado:nStamps auf [0,1] gestreckt, nach der Achse samian:axis_nStamps. Sample size. Logarithmic, because the counts run from 2 to 170 and a linear domain would put four fifths of the findspots in the darkest eighth of the ramp."@de,
        "Presentation only. The value of lado:nStamps stretched onto the unit interval by the axis samian:axis_nStamps. Sample size. Logarithmic, because the counts run from 2 to 170 and a linear domain would put four fifths of the findspots in the darkest eighth of the ramp."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:normQInterval a owl:DatatypeProperty ;
    rdfs:label "normalised qInterval"@en ;
    rdfs:comment "VISUAL ONLY. lado:qInterval auf [0,1] gestreckt, nach der Achse samian:axis_qInterval. Dating sharpness on its own 0-1 scale, so the domain is a fixed convention rather than the range this corpus happens to show. Green is sharp. Matches the legend of the box plot."@de,
        "Presentation only. The value of lado:qInterval stretched onto the unit interval by the axis samian:axis_qInterval. Dating sharpness on its own 0-1 scale, so the domain is a fixed convention rather than the range this corpus happens to show. Green is sharp. Matches the legend of the box plot."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:normSigmaYears a owl:DatatypeProperty ;
    rdfs:label "normalised sigmaYears"@en ;
    rdfs:comment "VISUAL ONLY. lado:sigmaYears auf [0,1] gestreckt, nach der Achse samian:axis_sigmaYears. The dispersion the interval is built from. Reversed, so that small sigma is green and agrees with the qInterval axis."@de,
        "Presentation only. The value of lado:sigmaYears stretched onto the unit interval by the axis samian:axis_sigmaYears. The dispersion the interval is built from. Reversed, so that small sigma is green and agrees with the qInterval axis."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:normalisedProperty a owl:ObjectProperty ;
    rdfs:label "normalised property"@en ;
    rdfs:comment "Die Eigenschaft, unter der der normierte Wert an der Plotzeile steht."@de,
        "The property under which this axis's normalised value appears on a plot row. Named in the graph so that a client can discover the axes rather than having the property names compiled into it."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range rdf:Property .

lado:padYears a owl:DatatypeProperty ;
    rdfs:label "pad years"@en ;
    rdfs:comment "Years of empty space added at each end of the time axis."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:possiblyAfter a owl:ObjectProperty ;
    rdfs:label "possibly after"@en ;
    rdfs:comment "Gilt auf dem modellierten Intervall [eff_start, eff_end]: diese Zeitspanne begins after the other ends, with a gap — aber nicht notwendig auch auf der weiteren Lesart bis zu den Extremwerten des Materials. Die belastbare Variante ist time:intervalAfter, eine Untereigenschaft hiervon."@de,
        "Holds on the modelled interval: this time-span begins after the other ends, with a gap. Every pair of datings stands in exactly one relation of this family, so the set is complete and can be counted. It does not claim that the relation survives a more generous reading of the bounds — where it does, time:intervalAfter is asserted as well, and that property is declared a subproperty of this one."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:possiblyBefore a owl:ObjectProperty ;
    rdfs:label "possibly before"@en ;
    rdfs:comment "Gilt auf dem modellierten Intervall [eff_start, eff_end]: diese Zeitspanne ends before the other begins, with a gap — aber nicht notwendig auch auf der weiteren Lesart bis zu den Extremwerten des Materials. Die belastbare Variante ist time:intervalBefore, eine Untereigenschaft hiervon."@de,
        "Holds on the modelled interval: this time-span ends before the other begins, with a gap. Every pair of datings stands in exactly one relation of this family, so the set is complete and can be counted. It does not claim that the relation survives a more generous reading of the bounds — where it does, time:intervalBefore is asserted as well, and that property is declared a subproperty of this one."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:possiblyContains a owl:ObjectProperty ;
    rdfs:label "possibly contains"@en ;
    rdfs:comment "Gilt auf dem modellierten Intervall [eff_start, eff_end]: diese Zeitspanne strictly encloses the other — aber nicht notwendig auch auf der weiteren Lesart bis zu den Extremwerten des Materials. Die belastbare Variante ist time:intervalContains, eine Untereigenschaft hiervon."@de,
        "Holds on the modelled interval: this time-span strictly encloses the other. Every pair of datings stands in exactly one relation of this family, so the set is complete and can be counted. It does not claim that the relation survives a more generous reading of the bounds — where it does, time:intervalContains is asserted as well, and that property is declared a subproperty of this one."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:possiblyDuring a owl:ObjectProperty ;
    rdfs:label "possibly during"@en ;
    rdfs:comment "Gilt auf dem modellierten Intervall [eff_start, eff_end]: diese Zeitspanne falls strictly inside the other — aber nicht notwendig auch auf der weiteren Lesart bis zu den Extremwerten des Materials. Die belastbare Variante ist time:intervalDuring, eine Untereigenschaft hiervon."@de,
        "Holds on the modelled interval: this time-span falls strictly inside the other. Every pair of datings stands in exactly one relation of this family, so the set is complete and can be counted. It does not claim that the relation survives a more generous reading of the bounds — where it does, time:intervalDuring is asserted as well, and that property is declared a subproperty of this one."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:possiblyEquals a owl:ObjectProperty ;
    rdfs:label "possibly equals"@en ;
    rdfs:comment "Gilt auf dem modellierten Intervall [eff_start, eff_end]: diese Zeitspanne has the same bounds as the other — aber nicht notwendig auch auf der weiteren Lesart bis zu den Extremwerten des Materials. Die belastbare Variante ist time:intervalEquals, eine Untereigenschaft hiervon."@de,
        "Holds on the modelled interval: this time-span has the same bounds as the other. Every pair of datings stands in exactly one relation of this family, so the set is complete and can be counted. It does not claim that the relation survives a more generous reading of the bounds — where it does, time:intervalEquals is asserted as well, and that property is declared a subproperty of this one."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:possiblyFinishedBy a owl:ObjectProperty ;
    rdfs:label "possibly finishedBy"@en ;
    rdfs:comment "Gilt auf dem modellierten Intervall [eff_start, eff_end]: diese Zeitspanne begins earlier and ends together with the other — aber nicht notwendig auch auf der weiteren Lesart bis zu den Extremwerten des Materials. Die belastbare Variante ist time:intervalFinishedBy, eine Untereigenschaft hiervon."@de,
        "Holds on the modelled interval: this time-span begins earlier and ends together with the other. Every pair of datings stands in exactly one relation of this family, so the set is complete and can be counted. It does not claim that the relation survives a more generous reading of the bounds — where it does, time:intervalFinishedBy is asserted as well, and that property is declared a subproperty of this one."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:possiblyFinishes a owl:ObjectProperty ;
    rdfs:label "possibly finishes"@en ;
    rdfs:comment "Gilt auf dem modellierten Intervall [eff_start, eff_end]: diese Zeitspanne begins later and ends together with the other — aber nicht notwendig auch auf der weiteren Lesart bis zu den Extremwerten des Materials. Die belastbare Variante ist time:intervalFinishes, eine Untereigenschaft hiervon."@de,
        "Holds on the modelled interval: this time-span begins later and ends together with the other. Every pair of datings stands in exactly one relation of this family, so the set is complete and can be counted. It does not claim that the relation survives a more generous reading of the bounds — where it does, time:intervalFinishes is asserted as well, and that property is declared a subproperty of this one."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:possiblyMeets a owl:ObjectProperty ;
    rdfs:label "possibly meets"@en ;
    rdfs:comment "Gilt auf dem modellierten Intervall [eff_start, eff_end]: diese Zeitspanne ends exactly where the other begins — aber nicht notwendig auch auf der weiteren Lesart bis zu den Extremwerten des Materials. Die belastbare Variante ist time:intervalMeets, eine Untereigenschaft hiervon."@de,
        "Holds on the modelled interval: this time-span ends exactly where the other begins. Every pair of datings stands in exactly one relation of this family, so the set is complete and can be counted. It does not claim that the relation survives a more generous reading of the bounds — where it does, time:intervalMeets is asserted as well, and that property is declared a subproperty of this one."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:possiblyMetBy a owl:ObjectProperty ;
    rdfs:label "possibly metBy"@en ;
    rdfs:comment "Gilt auf dem modellierten Intervall [eff_start, eff_end]: diese Zeitspanne begins exactly where the other ends — aber nicht notwendig auch auf der weiteren Lesart bis zu den Extremwerten des Materials. Die belastbare Variante ist time:intervalMetBy, eine Untereigenschaft hiervon."@de,
        "Holds on the modelled interval: this time-span begins exactly where the other ends. Every pair of datings stands in exactly one relation of this family, so the set is complete and can be counted. It does not claim that the relation survives a more generous reading of the bounds — where it does, time:intervalMetBy is asserted as well, and that property is declared a subproperty of this one."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:possiblyOverlappedBy a owl:ObjectProperty ;
    rdfs:label "possibly overlappedBy"@en ;
    rdfs:comment "Gilt auf dem modellierten Intervall [eff_start, eff_end]: diese Zeitspanne begins inside the other and outlasts it — aber nicht notwendig auch auf der weiteren Lesart bis zu den Extremwerten des Materials. Die belastbare Variante ist time:intervalOverlappedBy, eine Untereigenschaft hiervon."@de,
        "Holds on the modelled interval: this time-span begins inside the other and outlasts it. Every pair of datings stands in exactly one relation of this family, so the set is complete and can be counted. It does not claim that the relation survives a more generous reading of the bounds — where it does, time:intervalOverlappedBy is asserted as well, and that property is declared a subproperty of this one."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:possiblyOverlaps a owl:ObjectProperty ;
    rdfs:label "possibly overlaps"@en ;
    rdfs:comment "Gilt auf dem modellierten Intervall [eff_start, eff_end]: diese Zeitspanne begins first, ends inside the other — aber nicht notwendig auch auf der weiteren Lesart bis zu den Extremwerten des Materials. Die belastbare Variante ist time:intervalOverlaps, eine Untereigenschaft hiervon."@de,
        "Holds on the modelled interval: this time-span begins first, ends inside the other. Every pair of datings stands in exactly one relation of this family, so the set is complete and can be counted. It does not claim that the relation survives a more generous reading of the bounds — where it does, time:intervalOverlaps is asserted as well, and that property is declared a subproperty of this one."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:possiblyStartedBy a owl:ObjectProperty ;
    rdfs:label "possibly startedBy"@en ;
    rdfs:comment "Gilt auf dem modellierten Intervall [eff_start, eff_end]: diese Zeitspanne begins together with the other and outlasts it — aber nicht notwendig auch auf der weiteren Lesart bis zu den Extremwerten des Materials. Die belastbare Variante ist time:intervalStartedBy, eine Untereigenschaft hiervon."@de,
        "Holds on the modelled interval: this time-span begins together with the other and outlasts it. Every pair of datings stands in exactly one relation of this family, so the set is complete and can be counted. It does not claim that the relation survives a more generous reading of the bounds — where it does, time:intervalStartedBy is asserted as well, and that property is declared a subproperty of this one."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:possiblyStarts a owl:ObjectProperty ;
    rdfs:label "possibly starts"@en ;
    rdfs:comment "Gilt auf dem modellierten Intervall [eff_start, eff_end]: diese Zeitspanne begins together with the other and ends first — aber nicht notwendig auch auf der weiteren Lesart bis zu den Extremwerten des Materials. Die belastbare Variante ist time:intervalStarts, eine Untereigenschaft hiervon."@de,
        "Holds on the modelled interval: this time-span begins together with the other and ends first. Every pair of datings stands in exactly one relation of this family, so the set is complete and can be counted. It does not claim that the relation survives a more generous reading of the bounds — where it does, time:intervalStarts is asserted as well, and that property is declared a subproperty of this one."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:qEnd a owl:DatatypeProperty ;
    rdfs:label "q end"@en ;
    rdfs:comment "As qStart, for the end date."@de,
        "Sharpness of the end date, on the same scale as qStart."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:qInterval a owl:DatatypeProperty ;
    rdfs:label "q interval"@en ;
    rdfs:comment "Datierungsschaerfe (= q_spread). Erste Qualitaetsachse."@de,
        "The first quality axis, describing how tightly the contributing potter datings agree. It divides by the interval width, which is a difference and therefore carries no calendar origin."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:qRepetition a owl:DatatypeProperty ;
    rdfs:label "q repetition"@en ;
    rdfs:comment "1 - 1/rep. Zweite Qualitaetsachse. Bewusst NICHT mit qInterval verrechnet: 'kein Depot' ist nicht 'schlecht datiert'."@de,
        "1 − 1/repetition, the second quality axis. Deliberately not combined with qInterval: a findspot that is not a deposit is not thereby badly dated, and averaging the two would assert exactly that."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:qStart a owl:DatatypeProperty ;
    rdfs:label "q start"@en ;
    rdfs:comment "Sharpness of the start date, exp(-sigma / referenceLength). The denominator is a fixed length, not a calendar value, so the measure no longer depends on where in the calendar the material sits."@de,
        "Sharpness of the start date, exp(-sigma / referenceLength). Earlier versions divided by the mean calendar value, which penalised material dated near the era boundary for its position in the calendar rather than for any property of the evidence; since v27c the denominator is a fixed length and the measure is independent of epoch. The earlier form is kept in the source query as q_start_legacy, for reconstructing published figures."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:rampInterpolation a owl:DatatypeProperty ;
    rdfs:label "ramp interpolation"@en ;
    rdfs:comment "Wie zwischen den Stuetzstellen interpoliert wird. 'linear-rgb': kanalweise linear. Nicht identisch mit D3s Spline, siehe py/ips_colour.py."@de,
        "How colours between two anchors are obtained. 'linear-rgb' means each channel is interpolated linearly. This is not what D3's spline interpolators do; the two agree at the anchors and differ by a few units between them."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:rampName a owl:DatatypeProperty ;
    rdfs:label "ramp name"@en ;
    rdfs:comment "Name der Farbskala. BEWUSST NICHT lado:colourRamp: dort steht der Name einer D3-Funktion, die dieser Export nicht nachbildet. Hier steht eine Skala, die durch rampStops und rampInterpolation vollstaendig festgelegt ist."@de,
        "The name of the colour scale. Deliberately distinct from colourRamp, which holds the name of a D3 function that this export does not reproduce. A ramp named here is fully specified by its stops and its interpolation, and the resulting colours are reproducible from the graph without any library."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:rampStops a owl:DatatypeProperty ;
    rdfs:label "ramp stops"@en ;
    rdfs:comment "Die Stuetzstellen der Skala als Hexwerte, durch Leerzeichen getrennt, von 0 nach 1."@de,
        "The anchor colours of the scale, as hex values separated by spaces, running from the low end of the domain to the high end."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:referenceLength a owl:DatatypeProperty ;
    rdfs:label "reference length"@en ;
    rdfs:comment "Called t0 in the source query. The common time scale against which qStart and qEnd are read: q = exp(-sigma / referenceLength). A fixed length rather than a calendar value, which is what makes the measure independent of where in the calendar the material sits. Anchored on expert thresholds: sigma = 5 years counts as a sharp dating, sigma = 25 years as an unusable one."@de,
        "The common time scale on which qStart and qEnd are read, called t0 in the source query. Because it is a fixed length rather than a calendar value, the two edge measures no longer depend on the epoch of the material. Its value of 20 years is anchored on expert thresholds: a dispersion of 5 years counts as a sharp dating, one of 25 years as unusable, giving q of about 0.78 and 0.29 respectively. Until the calibration of tau it happened to carry the same value, which invited the two to be read as one constant; they are unrelated, and now they differ."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:renders a owl:ObjectProperty ;
    rdfs:label "renders"@en ;
    rdfs:comment "Verbindet eine Plotzeile mit der Datierung, die sie darstellt."@de,
        "Links a plot row to the dating it depicts. Following this property in reverse tells you whether a given dating appears in any published figure."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:rowHeight a owl:DatatypeProperty ;
    rdfs:label "row height"@en ;
    rdfs:comment "Height of one row, in pixels."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:rowOrder a owl:DatatypeProperty ;
    rdfs:label "row order"@en ;
    rdfs:comment "Sortierregel der Zeilen. Erlaubt es, die Reihenfolge der Abbildung aus dem Graphen zu reproduzieren."@de,
        "The rule by which rows are sorted, allowing the order of the published figure to be reproduced from the graph alone."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:sigmaYears a owl:DatatypeProperty ;
    rdfs:label "sigma (years)"@en ;
    rdfs:comment "sqrt( AVG(Breite^2/12) + VAR_SAMP(Mitten) ). Varianzzerlegung: innere Fuzziness plus Streuung der Intervallmitten."@de,
        "The dispersion entering the interval width, obtained by variance decomposition: the internal fuzziness of each potter's range plus the scatter of the range midpoints. Together with kFactor it determines the width of the box, which is 2·k·σ."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:svgWidth a owl:DatatypeProperty ;
    rdfs:label "svg width"@en ;
    rdfs:comment "Width of the figure canvas, in pixels."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:tau a owl:DatatypeProperty ;
    rdfs:label "tau"@en ;
    rdfs:comment "Saettigungskonstante. Bei n = tau sind rund 63 % der moeglichen Verschmaelerung erreicht."@de,
        "The saturation constant of the k curve. At n = τ roughly 63 per cent of the available narrowing has been achieved."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:uncEndYears a owl:DatatypeProperty ;
    rdfs:label "uncertainty end (years)"@en ;
    rdfs:comment "VISUAL ONLY. Siehe uncStartYears."@de,
        "Sample standard deviation of the contributing end dates. Presentation only, as for uncStartYears."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:uncIntervalYears a owl:DatatypeProperty ;
    rdfs:label "uncertainty interval (years)"@en ;
    rdfs:comment "VISUAL ONLY."@de,
        "Combined edge dispersion, sqrt(var(datemin) + var(datemax)). Presentation only."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:uncStartYears a owl:DatatypeProperty ;
    rdfs:label "uncertainty start (years)"@en ;
    rdfs:comment "VISUAL ONLY. STDDEV_SAMP(datemin). Laut Methodendoku die Streuung von nichts im Modell; deshalb an der Plotzeile, nicht an der Zeitspanne."@de,
        "Sample standard deviation of the contributing start dates. Presentation only: it measures the scatter of the interval edges, whereas the box is built from the scatter of the midpoints, so the whisker does not continue the box in any statistical sense."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:undefinedMeasure a owl:ObjectProperty ;
    rdfs:label "undefined measure"@en ;
    rdfs:comment "Benennt eine Groesse, die fuer diese Zeitspanne nicht berechenbar war. Macht Abwesenheit explizit, statt sie der Open-World-Annahme zu ueberlassen."@de,
        "Names a measure that could not be computed for this subject. Under the open-world assumption a missing triple is merely unknown; this property distinguishes 'we computed it and it does not exist' from 'nobody has looked yet'."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range rdf:Property .

lado:volumeWeight a owl:DatatypeProperty ;
    rdfs:label "volume weight"@en ;
    rdfs:comment "w = 1.0: k haengt rein am Volumen."@de,
        "Set to 1.0, recording that k depends on volume of evidence alone and on no other weighting."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

crmdig:D14_Software rdfs:subClassOf crmdig:D1_Digital_Object .

lado:Findspot a owl:Class ;
    rdfs:label "Findspot"@en ;
    rdfs:comment "Benannte Fundstelle innerhalb eines Fundplatzes. Faellt ueber crm:P89_falls_within in die DiscoverySite. Ein Fundplatz kann mehrere Fundstellen tragen, getrennt datiert und mitunter weit auseinander (Bregenz ist der Standardfall)."@de,
        "A named context within a discovery site, such as a pit, a ditch or a destruction layer. It falls within its site via crm:P89_falls_within. A site may carry several findspots, dated separately and sometimes far apart — Bregenz is the standing example — which is why the dating hangs on the findspot and not on the site."@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:subClassOf lado:Location .

crm:E11_Modification rdfs:subClassOf crm:E7_Activity .

crm:E65_Creation rdfs:subClassOf crm:E7_Activity .

crmdig:D10_Software_Execution rdfs:subClassOf crmdig:D7_Digital_Machine_Event .

crmdig:D1_Digital_Object rdfs:subClassOf crm:E73_Information_Object .

crmdig:D7_Digital_Machine_Event rdfs:subClassOf crm:E11_Modification,
        crm:E65_Creation .

lado:Location a owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:comment "Bestehende LADO-Klasse, hier in CIDOC CRM verankert."@de,
        "An existing LADO class, anchored here beneath crm:E53_Place so that consumers who reason over CIDOC CRM can reach it without knowing LADO."@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:subClassOf crm:E53_Place .

lado:DatingModel a owl:Class ;
    rdfs:label "Dating model"@en ;
    rdfs:comment "Parametrisierung, aus der die Intervalle berechnet wurden. Haengt an prov:Plan UND an crm:E29_Design_or_Procedure: sonst waere dies die einzige lokale Klasse, die CIDOC CRM nicht erreicht, und ein rein CRM-basierter Konsument saehe die Methode nicht, aus der die Datierungen stammen."@de,
        "The parameterisation from which the intervals were computed. Holds k_min, k_max, τ, w and the fuzziness divisor, so a reader can recompute any interval from the exported figures alone. It sits beneath prov:Plan and beneath crm:E29_Design_or_Procedure, the CIDOC CRM class for a documented procedure; without the second parent this would be the one local class that never reaches CIDOC CRM, and a CRM-only consumer could see the datings but not the method behind them."@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:subClassOf crm:E29_Design_or_Procedure,
        prov:Plan .

lado:ColourAxis a owl:Class ;
    rdfs:label "Colour axis"@en ;
    rdfs:comment "Eine Abbildung einer gemessenen Groesse auf eine Farbskala, vollstaendig beschrieben: Stuetzstellen, Interpolation, Normierungsbereich. Damit ist jeder Hexwert im Graphen aus dem Graphen selbst nachrechenbar und nicht nur zu glauben."@de,
        "A complete specification of how one measured quantity becomes a colour: the ramp stops, the interpolation between them, the domain the values are stretched onto and whether that domain is a fixed convention or was read off this corpus. Colour is presentation rather than evidence, so it is published here on the same terms as the other presentation-only quantities: as something a consumer can check and recompute rather than has to trust."@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:subClassOf crm:E36_Visual_Item .

lado:Figure a owl:Class ;
    rdfs:label "Figure"@en ;
    rdfs:comment "Abbildung. Traegt die Konstanten, die nicht zu den Fundplaetzen gehoeren, sondern zur Grafik."@de,
        "A published figure. Carries the constants that belong to the drawing rather than to the archaeology — padding, row height, colour ramp, sort order — so that they are stated once instead of being repeated on every row."@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:subClassOf crm:E36_Visual_Item .

lado:PlotRow a owl:Class ;
    rdfs:label "Plot row"@en ;
    rdfs:comment "Darstellungsschicht einer Datierung. Traegt ausdruecklich die Groessen, die laut Methodendoku 'visual only' sind."@de,
        "The presentation layer of a single dating. It deliberately carries the uncertainty whiskers, which the method documentation describes as visual only, keeping them off the time-span where they would read as an archaeological claim."@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:subClassOf crm:E36_Visual_Item .

lado:DatedTimeSpan a owl:Class ;
    rdfs:label "Dated time-span"@en ;
    rdfs:comment "Zeitspanne, die aus datiertem Material erschlossen wurde."@de,
        "A time-span inferred from dated material rather than recorded directly. Sits beneath both crm:E52_Time-Span and time:ProperInterval so that CIDOC-based and OWL-Time-based queries each find it by their own route."@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:subClassOf crm:E52_Time-Span,
        time:ProperInterval .

<http://archaeology.link/ontology> a owl:Ontology ;
    rdfs:label "LADO — Erweiterung fuer Fundstellen-Datierung"@de ;
    rdfs:comment "Erweitert LADO um Fundstellen, Datierungs-Zeitspannen und eine getrennte Darstellungsschicht. Alle Klassen haengen ueber rdfs:subClassOf unter CIDOC CRM."@de,
        "Contains a small number of rdfs:subClassOf axioms that belong to CRMdig and to CIDOC CRM rather than to this vocabulary. They are restated so that the standalone bundle resolves CIDOC CRM queries without those ontologies being loaded; they assert nothing new."@en .

