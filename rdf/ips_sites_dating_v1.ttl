samian:terminus_velsen_velsen_i a lado:IndependentTerminus,
        crm:E5_Event ;
    rdfs:label "Abandonment of the naval base, Velsen (AD 28)"@en ;
    lado:constrains samian:fs_1003421_a3fecc ;
    lado:independentEvidence "military base in operation, abandoned about AD 28"@en ;
    lado:terminusKind "terminus ante quem" ;
    lado:withheldBecause "Activity continued on the site after this date and admixture cannot be ruled out, which would make the terminus an upper bound on the site rather than on the assemblage. Excluding it leaves the calibrated tau unchanged, so nothing published depends on the decision."@en ;
    lado:withheldFromCriterion true ;
    crm:P4_has_time-span samian:terminus_velsen_velsen_i_instant .

