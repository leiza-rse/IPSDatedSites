# Which method produced these dates
# The parameters are in the graph, not only in the paper. Each dating is
# generated by an activity, and that activity records the plan it followed —
# so a consumer can ask what k, τ and the era convention were, and which
# datemax values the source query excluded, without reading any prose. The
# excluded values are an inherited filter whose justification is still open;
# publishing them is how that stays visible.

PREFIX samian:  <http://data.archaeology.link/data/samian/>
PREFIX lado:    <http://archaeology.link/ontology#>
PREFIX crm:     <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crmdig:  <http://www.ics.forth.gr/isl/CRMdig/>
PREFIX time:    <http://www.w3.org/2006/time#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dcat:    <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

SELECT ?software ?model ?kMin ?kMax ?tau ?w ?era
       (GROUP_CONCAT(DISTINCT STR(?ex); separator=", ") AS ?excludedDatemax)
       (COUNT(DISTINCT ?ts) AS ?datings)
WHERE {
  ?ts a lado:FindspotDating ; prov:wasGeneratedBy ?act .
  ?act crm:P33_used_specific_technique ?m ;
       crm:P14_carried_out_by ?agent .
  ?agent rdfs:label ?software .
  ?m rdfs:label ?model ; lado:kMin ?kMin ; lado:kMax ?kMax ;
     lado:tau ?tau ; lado:volumeWeight ?w ; lado:eraConvention ?era ;
     lado:excludedDatemax ?ex .
}
GROUP BY ?software ?model ?kMin ?kMax ?tau ?w ?era
