samian:terminus_dangstetten_military_camp a lado:IndependentTerminus,
        crm:E5_Event ;
    rdfs:label "Abandonment of the legionary camp, Dangstetten (8 BC)"@en ;
    lado:constrains samian:fs_1003909_c2e54a ;
    lado:independentEvidence "coin-dated, 15 to 8 BC"@en ;
    lado:terminusKind "terminus ante quem" ;
    crm:P4_has_time-span samian:terminus_dangstetten_military_camp_instant .

samian:terminus_inchtuthil_gutter a lado:IndependentTerminus,
        crm:E5_Event ;
    rdfs:label "Abandonment of the legionary fortress, Inchtuthil (AD 87)"@en ;
    lado:constrains samian:fs_1003524_dd3cae ;
    lado:independentEvidence "historically dated abandonment"@en ;
    lado:terminusKind "terminus ante quem" ;
    crm:P4_has_time-span samian:terminus_inchtuthil_gutter_instant .

samian:terminus_oberaden_military_camp a lado:IndependentTerminus,
        crm:E5_Event ;
    rdfs:label "Abandonment of the legionary camp, Oberaden (7 BC)"@en ;
    lado:constrains samian:fs_1002611_c2e54a ;
    lado:independentEvidence "dendrochronology, ending 7 BC"@en ;
    lado:terminusKind "terminus ante quem" ;
    crm:P4_has_time-span samian:terminus_oberaden_military_camp_instant .

samian:terminus_pompeii_hoard a lado:IndependentTerminus,
        crm:E5_Event ;
