    crm:P4_has_time-span samian:terminus_pompeii_hoard_instant .

samian:terminus_velsen_velsen_i a lado:IndependentTerminus,
        crm:E5_Event ;
    rdfs:label "Abandonment of the naval base, Velsen (AD 28)"@en ;
    lado:constrains samian:fs_1003421_a3fecc ;
    lado:independentEvidence "military base in operation, abandoned about AD 28"@en ;
    lado:terminusKind "terminus ante quem" ;
    lado:withheldBecause "Activity continued on the site after this date and admixture cannot be ruled out, which would make the terminus an upper bound on the site rather than on the assemblage. Excluding it leaves the calibrated tau unchanged, so nothing published depends on the decision."@en ;
    lado:withheldFromCriterion true ;
    crm:P4_has_time-span samian:terminus_velsen_velsen_i_instant .

time:intervalAfter rdfs:subPropertyOf lado:possiblyAfter .

time:intervalBefore rdfs:subPropertyOf lado:possiblyBefore .

time:intervalContains rdfs:subPropertyOf lado:possiblyContains .

time:intervalDuring rdfs:subPropertyOf lado:possiblyDuring .

time:intervalEquals rdfs:subPropertyOf lado:possiblyEquals .

time:intervalFinishedBy rdfs:subPropertyOf lado:possiblyFinishedBy .

time:intervalFinishes rdfs:subPropertyOf lado:possiblyFinishes .

time:intervalMeets rdfs:subPropertyOf lado:possiblyMeets .

time:intervalMetBy rdfs:subPropertyOf lado:possiblyMetBy .

time:intervalOverlappedBy rdfs:subPropertyOf lado:possiblyOverlappedBy .

time:intervalOverlaps rdfs:subPropertyOf lado:possiblyOverlaps .

time:intervalStartedBy rdfs:subPropertyOf lado:possiblyStartedBy .

time:intervalStarts rdfs:subPropertyOf lado:possiblyStarts .

lado:YearScale a owl:Class ;
    rdfs:label "Year scale"@en ;
    rdfs:comment "Das Zeitreferenzsystem, auf dem die Zahlenangaben liegen. Eine dokumentierte Konvention und damit ein crm:E73_Information_Object."@de,
        "The temporal reference system the numeric positions are read on. A documented convention, and therefore a crm:E73_Information_Object. Its definition matters because the positions are signed years on a continuous line, not calendar labels — see eraConvention."@en ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:subClassOf crm:E73_Information_Object,
        time:TRS .

lado:hexMidpointYear a owl:DatatypeProperty ;
    rdfs:label "colour for midpointYear"@en ;
    rdfs:comment "VISUAL ONLY. Der Hexwert zu lado:normMidpointYear auf der Skala samian:axis_midpointYear. Aus dem Graphen nachrechenbar."@de,
        "Presentation only. The colour corresponding to lado:normMidpointYear on the axis samian:axis_midpointYear. Recomputable from that axis's stops and interpolation; carried in the graph so that two maps of the same data cannot disagree about the scale."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:hexNStamps a owl:DatatypeProperty ;
    rdfs:label "colour for nStamps"@en ;
    rdfs:comment "VISUAL ONLY. Der Hexwert zu lado:normNStamps auf der Skala samian:axis_nStamps. Aus dem Graphen nachrechenbar."@de,
        "Presentation only. The colour corresponding to lado:normNStamps on the axis samian:axis_nStamps. Recomputable from that axis's stops and interpolation; carried in the graph so that two maps of the same data cannot disagree about the scale."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:hexQInterval a owl:DatatypeProperty ;
    rdfs:label "colour for qInterval"@en ;
    rdfs:comment "VISUAL ONLY. Der Hexwert zu lado:normQInterval auf der Skala samian:axis_qInterval. Aus dem Graphen nachrechenbar."@de,
        "Presentation only. The colour corresponding to lado:normQInterval on the axis samian:axis_qInterval. Recomputable from that axis's stops and interpolation; carried in the graph so that two maps of the same data cannot disagree about the scale."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:hexSigmaYears a owl:DatatypeProperty ;
    rdfs:label "colour for sigmaYears"@en ;
    rdfs:comment "VISUAL ONLY. Der Hexwert zu lado:normSigmaYears auf der Skala samian:axis_sigmaYears. Aus dem Graphen nachrechenbar."@de,
        "Presentation only. The colour corresponding to lado:normSigmaYears on the axis samian:axis_sigmaYears. Recomputable from that axis's stops and interpolation; carried in the graph so that two maps of the same data cannot disagree about the scale."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:midpointYear a owl:DatatypeProperty ;
    rdfs:label "midpoint year"@en ;
    rdfs:comment "The centre of the averaged interval, the m in m ± k·σ."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:nStamps a owl:DatatypeProperty ;
    rdfs:label "number of stamps"@en ;
    rdfs:comment "Anzahl Stempel an der Fundstelle (count_stamps)."@de,
        "The number of stamps recorded at the findspot. Note that this is not the n used by the k formula — see nStampsWithDie."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:normMidpointYear a owl:DatatypeProperty ;
    rdfs:label "normalised midpointYear"@en ;
    rdfs:comment "VISUAL ONLY. lado:midpointYear auf [0,1] gestreckt, nach der Achse samian:axis_midpointYear. Chronological position. A sequential ramp on purpose: red-green would read as a judgement, and late material is not worse material."@de,
        "Presentation only. The value of lado:midpointYear stretched onto the unit interval by the axis samian:axis_midpointYear. Chronological position. A sequential ramp on purpose: red-green would read as a judgement, and late material is not worse material."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:normNStamps a owl:DatatypeProperty ;
    rdfs:label "normalised nStamps"@en ;
    rdfs:comment "VISUAL ONLY. lado:nStamps auf [0,1] gestreckt, nach der Achse samian:axis_nStamps. Sample size. Logarithmic, because the counts run from 2 to 170 and a linear domain would put four fifths of the findspots in the darkest eighth of the ramp."@de,
        "Presentation only. The value of lado:nStamps stretched onto the unit interval by the axis samian:axis_nStamps. Sample size. Logarithmic, because the counts run from 2 to 170 and a linear domain would put four fifths of the findspots in the darkest eighth of the ramp."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:normQInterval a owl:DatatypeProperty ;
    rdfs:label "normalised qInterval"@en ;
    rdfs:comment "VISUAL ONLY. lado:qInterval auf [0,1] gestreckt, nach der Achse samian:axis_qInterval. Dating sharpness on its own 0-1 scale, so the domain is a fixed convention rather than the range this corpus happens to show. Green is sharp. Matches the legend of the box plot."@de,
        "Presentation only. The value of lado:qInterval stretched onto the unit interval by the axis samian:axis_qInterval. Dating sharpness on its own 0-1 scale, so the domain is a fixed convention rather than the range this corpus happens to show. Green is sharp. Matches the legend of the box plot."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:normSigmaYears a owl:DatatypeProperty ;
    rdfs:label "normalised sigmaYears"@en ;
    rdfs:comment "VISUAL ONLY. lado:sigmaYears auf [0,1] gestreckt, nach der Achse samian:axis_sigmaYears. The dispersion the interval is built from. Reversed, so that small sigma is green and agrees with the qInterval axis."@de,
        "Presentation only. The value of lado:sigmaYears stretched onto the unit interval by the axis samian:axis_sigmaYears. The dispersion the interval is built from. Reversed, so that small sigma is green and agrees with the qInterval axis."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:qInterval a owl:DatatypeProperty ;
    rdfs:label "q interval"@en ;
    rdfs:comment "Datierungsschaerfe (= q_spread). Erste Qualitaetsachse."@de,
        "The first quality axis, describing how tightly the contributing potter datings agree. It divides by the interval width, which is a difference and therefore carries no calendar origin."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:sigmaYears a owl:DatatypeProperty ;
    rdfs:label "sigma (years)"@en ;
    rdfs:comment "sqrt( AVG(Breite^2/12) + VAR_SAMP(Mitten) ). Varianzzerlegung: innere Fuzziness plus Streuung der Intervallmitten."@de,
        "The dispersion entering the interval width, obtained by variance decomposition: the internal fuzziness of each potter's range plus the scatter of the range midpoints. Together with kFactor it determines the width of the box, which is 2·k·σ."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

