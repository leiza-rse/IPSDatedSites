samian:axis_midpointYear a lado:ColourAxis,
        crm:E36_Visual_Item ;
    rdfs:label "Colour axis: midpointYear"@en ;
    lado:colourSource lado:midpointYear ;
    lado:domainBasis "observed" ;
    lado:domainMax 218.84600 ;
    lado:domainMin -8.90200 ;
    lado:domainScale "linear" ;
    lado:hexProperty lado:hexMidpointYear ;
    lado:normalisedProperty lado:normMidpointYear ;
    lado:rampInterpolation "linear-rgb" ;
    lado:rampName "viridis" ;
    lado:rampStops "#440154 #472d7b #3b528b #2c728e #21918c #28ae80 #5ec962 #addc30 #fde725" ;
    rdfs:comment "Chronological position. A sequential ramp on purpose: red-green would read as a judgement, and late material is not worse material."@en .

samian:axis_nStamps a lado:ColourAxis,
        crm:E36_Visual_Item ;
    rdfs:label "Colour axis: nStamps"@en ;
    lado:colourSource lado:nStamps ;
    lado:domainBasis "observed" ;
    lado:domainMax 170.00000 ;
    lado:domainMin 2.00000 ;
    lado:domainScale "log" ;
    lado:hexProperty lado:hexNStamps ;
    lado:normalisedProperty lado:normNStamps ;
    lado:rampInterpolation "linear-rgb" ;
    lado:rampName "cividis" ;
    lado:rampStops "#00224e #123570 #3b496c #575d6d #707173 #8a8678 #a59c74 #c3b369 #fee838" ;
    rdfs:comment "Sample size. Logarithmic, because the counts run from 2 to 170 and a linear domain would put four fifths of the findspots in the darkest eighth of the ramp."@en .

samian:axis_qInterval a lado:ColourAxis,
        crm:E36_Visual_Item ;
    rdfs:label "Colour axis: qInterval"@en ;
    lado:colourSource lado:qInterval ;
    lado:domainBasis "fixed" ;
    lado:domainMax 1.00000 ;
    lado:domainMin 0.00000 ;
    lado:domainScale "linear" ;
    lado:hexProperty lado:hexQInterval ;
    lado:normalisedProperty lado:normQInterval ;
    lado:rampInterpolation "linear-rgb" ;
    lado:rampName "RdYlGn" ;
    lado:rampStops "#a50026 #d73027 #f46d43 #fdae61 #fee08b #ffffbf #d9ef8b #a6d96a #66bd63 #1a9850 #006837" ;
    rdfs:comment "Dating sharpness on its own 0-1 scale, so the domain is a fixed convention rather than the range this corpus happens to show. Green is sharp. Matches the legend of the box plot."@en .

samian:axis_sigmaYears a lado:ColourAxis,
        crm:E36_Visual_Item ;
    rdfs:label "Colour axis: sigmaYears"@en ;
    lado:colourSource lado:sigmaYears ;
    lado:domainBasis "observed" ;
    lado:domainMax 28.69600 ;
    lado:domainMin 5.77400 ;
    lado:domainScale "linear" ;
    lado:hexProperty lado:hexSigmaYears ;
    lado:normalisedProperty lado:normSigmaYears ;
    lado:rampInterpolation "linear-rgb" ;
    lado:rampName "RdYlGn-reversed" ;
    lado:rampStops "#006837 #1a9850 #66bd63 #a6d96a #d9ef8b #ffffbf #fee08b #fdae61 #f46d43 #d73027 #a50026" ;
    rdfs:comment "The dispersion the interval is built from. Reversed, so that small sigma is green and agrees with the qInterval axis."@en .

