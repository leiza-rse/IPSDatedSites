@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmdig: <http://www.ics.forth.gr/isl/CRMdig/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix lado: <http://archaeology.link/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pleiades: <https://pleiades.stoa.org/places/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix samian: <http://data.archaeology.link/data/samian/> .
@prefix sf: <http://www.opengis.net/ont/sf#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lado:avgDatemax a owl:DatatypeProperty ;
    rdfs:label "average datemax"@en ;
    rdfs:comment "Mean of the contributing potters' end dates."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:avgDatemin a owl:DatatypeProperty ;
    rdfs:label "average datemin"@en ;
    rdfs:comment "Mean of the contributing potters' start dates."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:bandPadding a owl:DatatypeProperty ;
    rdfs:label "band padding"@en ;
    rdfs:comment "Fraction of each row left empty between bars, following the d3.scaleBand convention."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:calibratedAgainst a owl:ObjectProperty ;
    rdfs:label "calibrated against"@en ;
    rdfs:comment "A findspot whose date is known independently of samian ware, used to fix the coverage factor. Naming them in the graph is the point: a calibration whose reference set is not published cannot be checked."@de,
        "A findspot whose date rests on dendrochronology, coins or a historical event rather than on samian ware. Naming them in the graph is the point: a calibration whose reference set is not published cannot be checked, and one calibrated against samian-dated ensembles would be circular. Two candidates were dropped for exactly that reason."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:Findspot .

lado:calibrationBasis a owl:DatatypeProperty ;
    rdfs:label "calibration basis"@en ;
    rdfs:comment "How the coverage factor was obtained. A plain-language statement, not a machine-readable procedure: it says which criterion was applied so that a reader can judge the number rather than take it on trust."@de,
        "How the coverage factor was arrived at, in words. The value of tau was not chosen for elegance: it is the smallest value at which every reference findspot's terminus ante quem still falls inside its interval. k_min and k_max remain set conventions, because five reference ensembles cannot separate three parameters — attempting it produced 2 424 parameter combinations that fit the data equally well."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:colourRamp a owl:DatatypeProperty ;
    rdfs:label "colour ramp"@en ;
    rdfs:comment "Name of the colour ramp mapping quality to colour, recorded so that a reader can reproduce the fill colours rather than eyeballing them."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:colourSource a owl:ObjectProperty ;
    rdfs:label "colour source"@en ;
    rdfs:comment "Die gemessene Eigenschaft, aus der diese Achse ihre Werte nimmt."@de,
        "The measured property an axis takes its values from. Following it leads from the colour back to the evidence."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range rdf:Property .

lado:constrains a owl:ObjectProperty ;
    rdfs:label "constrains"@en ;
    rdfs:comment "Das Ensemble, fuer das dieser Termin eine Schranke setzt."@de,
        "The assemblage a terminus sets a bound on. Following it leads from the fixed point to the dating it constrains, and back."@en ;
    rdfs:domain lado:IndependentTerminus ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:Findspot .

lado:dieRepetition a owl:DatatypeProperty ;
    rdfs:label "die repetition"@en ;
    rdfs:comment "nStampsWithDie / nDies. Depot-Indikator."@de,
        "nStampsWithDie divided by nDies. High values indicate that the same dies recur, which is characteristic of a hoard or a closed deposit rather than of accumulated site refuse."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:domainBasis a owl:DatatypeProperty ;
    rdfs:label "domain basis"@en ;
    rdfs:comment "'fixed': gesetzte Konvention, bleibt bei wachsendem Korpus stehen. 'observed': aus diesem Korpus gelesen — kommen Fundstellen hinzu, verschieben sich die Farben auch der unveraenderten."@de,
        "Whether the domain is a fixed convention or was observed in this corpus. The distinction matters for anyone comparing two snapshots: an observed domain moves when findspots are added, so an unchanged findspot can change colour without its dating having changed at all."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:domainMax a owl:DatatypeProperty ;
    rdfs:label "domain maximum"@en ;
    rdfs:comment "Wert, der auf 1 abgebildet wird."@de,
        "The value mapped to the high end of the ramp."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:domainMin a owl:DatatypeProperty ;
    rdfs:label "domain minimum"@en ;
    rdfs:comment "Wert, der auf 0 abgebildet wird."@de,
        "The value mapped to the low end of the ramp. Values below it are clamped rather than dropped."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:domainScale a owl:DatatypeProperty ;
    rdfs:label "domain scale"@en ;
    rdfs:comment "'linear' oder 'log'."@de,
        "Whether values are stretched linearly or logarithmically. Logarithmic where the quantity spans orders of magnitude, so that the ramp is not exhausted by a handful of large sites."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:eraConvention a owl:DatatypeProperty ;
    rdfs:label "era convention"@en ;
    rdfs:comment "Wie negative Jahreszahlen der Quelle zu lesen sind."@de,
        "How negative years in the source are to be read. Under 'historical', −40 means 40 BC, and the derived xsd:gYear label is shifted by one because XSD counts astronomically. Only the calendar label is shifted; the numeric position is left untouched."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:excludedDatemax a owl:DatatypeProperty ;
    rdfs:label "excluded datemax value"@en ;
    rdfs:comment "Filter p.datemax NOT IN (...) aus der Quell-Query. Bedeutung ungeklaert. Der Filter ist nicht neutral: er entfernt die betroffenen Toepfer an ALLEN Fundplaetzen."@de,
        "A datemax value removed by the source query's filter. The reason for the exclusion is not currently documented. The filter is not neutral: it removes the affected potters at every findspot, so it is recorded here rather than left silent."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:extremeStubYears a owl:DatatypeProperty ;
    rdfs:label "extreme stub years"@en ;
    rdfs:comment "Length of the stub drawn at each extreme value. The full range line was replaced by these stubs in the web application, and both figures follow that decision."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:fuzzinessDivisor a owl:DatatypeProperty ;
    rdfs:label "fuzziness divisor"@en ;
    rdfs:comment "12 = Varianz der Gleichverteilung. Die Verteilungsannahme pro Stempel steckt hier."@de,
        "The value 12, being the variance of a uniform distribution over a unit range. This is where the per-stamp distributional assumption enters the model, and stating it makes that assumption inspectable rather than implicit."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:hasColourAxis a owl:ObjectProperty ;
    rdfs:label "has colour axis"@en ;
    rdfs:comment "Verbindet die Abbildung mit einer der Farbachsen, nach denen ihre Zeilen eingefaerbt werden koennen."@de,
        "Relates a figure to a colour axis its rows can be shaded by. A figure carries several, because sharpness, chronology, dispersion and sample size answer different questions and choosing between them belongs to whoever is drawing the map."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:ColourAxis .

lado:hasRow a owl:ObjectProperty ;
    rdfs:label "has row"@en ;
    rdfs:comment "Links a figure to the plot rows it contains."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:PlotRow .

lado:hexProperty a owl:ObjectProperty ;
    rdfs:label "hex property"@en ;
    rdfs:comment "Die Eigenschaft, unter der der Hexwert an der Plotzeile steht."@de,
        "The property under which this axis's colour appears on a plot row. See normalisedProperty for why it is named rather than assumed."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range rdf:Property .

lado:identifierScheme a owl:DatatypeProperty ;
    rdfs:label "identifier scheme"@en ;
    rdfs:comment "Rezept, nach dem die Fundstellen-Fragmente gebildet werden. Muss von jeder weiteren Implementierung zeichengenau reproduziert werden, sonst entstehen abweichende URIs."@de,
        "The recipe by which findspot URI fragments are built. Any further implementation must reproduce it character for character, including the Unicode normalisation step, or it will mint different URIs for the same findspot."@en ;
    rdfs:domain dcat:Dataset ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:independentEvidence a owl:DatatypeProperty ;
    rdfs:label "independent evidence"@en ;
    rdfs:comment "Woher das Datum stammt. Muss von Sigillata unabhaengig sein, sonst waere die Kalibrierung zirkulaer."@de,
        "Where the date comes from. It has to be independent of samian, or the calibration would be circular — the model would be tuned against dates the model itself produced."@en ;
    rdfs:domain lado:IndependentTerminus ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:intervalLabel a owl:DatatypeProperty ;
    rdfs:label "interval label"@en ;
    rdfs:comment "Textform aus der Query (avg_interval)."@de,
        "The interval rendered as text by the source query, retained for display and for comparison against the published web output."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:kFactor a owl:DatatypeProperty ;
    rdfs:label "k factor"@en ;
    rdfs:comment "k = k_max - (k_max-k_min)*(1-exp(-n/tau)), rein volumenbasiert."@de,
        "The volume-based multiplier applied to sigmaYears. It falls from k_max towards k_min as evidence accumulates, so a findspot with many stamps receives a narrower interval than one with few."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:kMax a owl:DatatypeProperty ;
    rdfs:label "k max"@en ;
    rdfs:comment "Upper bound of the k factor, applied when evidence is thin or absent."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:kMin a owl:DatatypeProperty ;
    rdfs:label "k min"@en ;
    rdfs:comment "Lower bound of the k factor, approached as evidence accumulates."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:kNoDieRecord a owl:DatatypeProperty ;
    rdfs:label "k no die record"@en ;
    rdfs:comment "true = fuer diese Fundstelle liegt keine Stempeltyp-Erfassung vor. Seit 30a ohne Wirkung auf das Intervall: ein Hinweis auf eine Luecke im Datenbestand, kein Modellzustand."@de,
        "True where no die attribution exists at all for the findspot. Up to revision 30a this condition set k to k_max and widened the interval for a reason unconnected with the material; it now has no effect on the dating and records a gap in the die record instead."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:boolean .

lado:marginBottom a owl:DatatypeProperty ;
    rdfs:label "margin bottom"@en ;
    rdfs:comment "Bottom margin, in pixels."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:marginLeft a owl:DatatypeProperty ;
    rdfs:label "margin left"@en ;
    rdfs:comment "Left margin, in pixels; it accommodates the site and findspot labels."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:marginRight a owl:DatatypeProperty ;
    rdfs:label "margin right"@en ;
    rdfs:comment "Right margin, in pixels."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:marginTop a owl:DatatypeProperty ;
    rdfs:label "margin top"@en ;
    rdfs:comment "Top margin, in pixels."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:maxDatemax a owl:DatatypeProperty ;
    rdfs:label "maximum datemax"@en ;
    rdfs:comment "Latest end date among the contributing potters. Drawn as the right extreme stub in both figures."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:maxDatemin a owl:DatatypeProperty ;
    rdfs:label "maximum datemin"@en ;
    rdfs:comment "Latest start date among the contributing potters."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:minDatemax a owl:DatatypeProperty ;
    rdfs:label "minimum datemax"@en ;
    rdfs:comment "Earliest end date among the contributing potters."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:minDatemin a owl:DatatypeProperty ;
    rdfs:label "minimum datemin"@en ;
    rdfs:comment "Earliest start date among the contributing potters. Drawn as the left extreme stub in both figures."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:nDies a owl:DatatypeProperty ;
    rdfs:label "number of dies"@en ;
    rdfs:comment "The number of distinct dies attested at the findspot, counted over the pair (potter, die)."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:nStampsWithDie a owl:DatatypeProperty ;
    rdfs:label "number of stamps with a die"@en ;
    rdfs:comment "ACHTUNG: das n der k-Formel. Zaehlt nur Stempel mit Die-Angabe und ist NICHT nStamps."@de,
        "The number of stamps that carry a die attribution. This is the n in the k formula. It is smaller than nStamps because the underlying query counts only rows where a die is recorded. Substituting nStamps here yields a different k from the one actually used, which is why both are exported."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:normalisedProperty a owl:ObjectProperty ;
    rdfs:label "normalised property"@en ;
    rdfs:comment "Die Eigenschaft, unter der der normierte Wert an der Plotzeile steht."@de,
        "The property under which this axis's normalised value appears on a plot row. Named in the graph so that a client can discover the axes rather than having the property names compiled into it."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range rdf:Property .

lado:padYears a owl:DatatypeProperty ;
    rdfs:label "pad years"@en ;
    rdfs:comment "Years of empty space added at each end of the time axis."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:qEnd a owl:DatatypeProperty ;
    rdfs:label "q end"@en ;
    rdfs:comment "As qStart, for the end date."@de,
        "Sharpness of the end date, on the same scale as qStart."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:qRepetition a owl:DatatypeProperty ;
    rdfs:label "q repetition"@en ;
    rdfs:comment "1 - 1/rep. Zweite Qualitaetsachse. Bewusst NICHT mit qInterval verrechnet: 'kein Depot' ist nicht 'schlecht datiert'."@de,
        "1 − 1/repetition, the second quality axis. Deliberately not combined with qInterval: a findspot that is not a deposit is not thereby badly dated, and averaging the two would assert exactly that."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:qStart a owl:DatatypeProperty ;
    rdfs:label "q start"@en ;
    rdfs:comment "Sharpness of the start date, exp(-sigma / referenceLength). The denominator is a fixed length, not a calendar value, so the measure no longer depends on where in the calendar the material sits."@de,
        "Sharpness of the start date, exp(-sigma / referenceLength). Earlier versions divided by the mean calendar value, which penalised material dated near the era boundary for its position in the calendar rather than for any property of the evidence; since v27c the denominator is a fixed length and the measure is independent of epoch. The earlier form is kept in the source query as q_start_legacy, for reconstructing published figures."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:rampInterpolation a owl:DatatypeProperty ;
    rdfs:label "ramp interpolation"@en ;
    rdfs:comment "Wie zwischen den Stuetzstellen interpoliert wird. 'linear-rgb': kanalweise linear. Nicht identisch mit D3s Spline, siehe py/ips_colour.py."@de,
        "How colours between two anchors are obtained. 'linear-rgb' means each channel is interpolated linearly. This is not what D3's spline interpolators do; the two agree at the anchors and differ by a few units between them."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:rampName a owl:DatatypeProperty ;
    rdfs:label "ramp name"@en ;
    rdfs:comment "Name der Farbskala. BEWUSST NICHT lado:colourRamp: dort steht der Name einer D3-Funktion, die dieser Export nicht nachbildet. Hier steht eine Skala, die durch rampStops und rampInterpolation vollstaendig festgelegt ist."@de,
        "The name of the colour scale. Deliberately distinct from colourRamp, which holds the name of a D3 function that this export does not reproduce. A ramp named here is fully specified by its stops and its interpolation, and the resulting colours are reproducible from the graph without any library."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:rampStops a owl:DatatypeProperty ;
    rdfs:label "ramp stops"@en ;
    rdfs:comment "Die Stuetzstellen der Skala als Hexwerte, durch Leerzeichen getrennt, von 0 nach 1."@de,
        "The anchor colours of the scale, as hex values separated by spaces, running from the low end of the domain to the high end."@en ;
    rdfs:domain lado:ColourAxis ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:referenceLength a owl:DatatypeProperty ;
    rdfs:label "reference length"@en ;
    rdfs:comment "Called t0 in the source query. The common time scale against which qStart and qEnd are read: q = exp(-sigma / referenceLength). A fixed length rather than a calendar value, which is what makes the measure independent of where in the calendar the material sits. Anchored on expert thresholds: sigma = 5 years counts as a sharp dating, sigma = 25 years as an unusable one."@de,
        "The common time scale on which qStart and qEnd are read, called t0 in the source query. Because it is a fixed length rather than a calendar value, the two edge measures no longer depend on the epoch of the material. Its value of 20 years is anchored on expert thresholds: a dispersion of 5 years counts as a sharp dating, one of 25 years as unusable, giving q of about 0.78 and 0.29 respectively. Until the calibration of tau it happened to carry the same value, which invited the two to be read as one constant; they are unrelated, and now they differ."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:renders a owl:ObjectProperty ;
    rdfs:label "renders"@en ;
    rdfs:comment "Verbindet eine Plotzeile mit der Datierung, die sie darstellt."@de,
        "Links a plot row to the dating it depicts. Following this property in reverse tells you whether a given dating appears in any published figure."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range lado:DatedTimeSpan .

lado:rowHeight a owl:DatatypeProperty ;
    rdfs:label "row height"@en ;
    rdfs:comment "Height of one row, in pixels."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:rowOrder a owl:DatatypeProperty ;
    rdfs:label "row order"@en ;
    rdfs:comment "Sortierregel der Zeilen. Erlaubt es, die Reihenfolge der Abbildung aus dem Graphen zu reproduzieren."@de,
        "The rule by which rows are sorted, allowing the order of the published figure to be reproduced from the graph alone."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:svgWidth a owl:DatatypeProperty ;
    rdfs:label "svg width"@en ;
    rdfs:comment "Width of the figure canvas, in pixels."@en ;
    rdfs:domain lado:Figure ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:tau a owl:DatatypeProperty ;
    rdfs:label "tau"@en ;
    rdfs:comment "Saettigungskonstante. Bei n = tau sind rund 63 % der moeglichen Verschmaelerung erreicht."@de,
        "The saturation constant of the k curve. At n = τ roughly 63 per cent of the available narrowing has been achieved."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:terminusKind a owl:DatatypeProperty ;
    rdfs:label "terminus kind"@en ;
    rdfs:comment "Welche Art von Schranke. 'terminus ante quem': das Material lag spaetestens zu diesem Zeitpunkt am Fundort. AUSDRUECKLICH KEIN Herstellungsdatum — Pompeji 79 heisst, dass die Ware 79 dort lag, nicht dass sie 79 produziert wurde."@de,
        "What kind of bound this is. A terminus ante quem says the material was in place by that date; it is emphatically not a production date. Pompeii AD 79 means the ware was there when Vesuvius erupted, not that it was made in 79. Blurring the two is the standard way of over-reading a fixed point, and the distinction is why this property exists rather than a bare year."@en ;
    rdfs:domain lado:IndependentTerminus ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:uncEndYears a owl:DatatypeProperty ;
    rdfs:label "uncertainty end (years)"@en ;
    rdfs:comment "VISUAL ONLY. Siehe uncStartYears."@de,
        "Sample standard deviation of the contributing end dates. Presentation only, as for uncStartYears."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:uncIntervalYears a owl:DatatypeProperty ;
    rdfs:label "uncertainty interval (years)"@en ;
    rdfs:comment "VISUAL ONLY."@de,
        "Combined edge dispersion, sqrt(var(datemin) + var(datemax)). Presentation only."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:uncStartYears a owl:DatatypeProperty ;
    rdfs:label "uncertainty start (years)"@en ;
    rdfs:comment "VISUAL ONLY. STDDEV_SAMP(datemin). Laut Methodendoku die Streuung von nichts im Modell; deshalb an der Plotzeile, nicht an der Zeitspanne."@de,
        "Sample standard deviation of the contributing start dates. Presentation only: it measures the scatter of the interval edges, whereas the box is built from the scatter of the midpoints, so the whisker does not continue the box in any statistical sense."@en ;
    rdfs:domain lado:PlotRow ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:integer .

lado:undefinedMeasure a owl:ObjectProperty ;
    rdfs:label "undefined measure"@en ;
    rdfs:comment "Benennt eine Groesse, die fuer diese Zeitspanne nicht berechenbar war. Macht Abwesenheit explizit, statt sie der Open-World-Annahme zu ueberlassen."@de,
        "Names a measure that could not be computed for this subject. Under the open-world assumption a missing triple is merely unknown; this property distinguishes 'we computed it and it does not exist' from 'nobody has looked yet'."@en ;
    rdfs:domain lado:DatedTimeSpan ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range rdf:Property .

lado:volumeWeight a owl:DatatypeProperty ;
    rdfs:label "volume weight"@en ;
    rdfs:comment "w = 1.0: k haengt rein am Volumen."@de,
        "Set to 1.0, recording that k depends on volume of evidence alone and on no other weighting."@en ;
    rdfs:domain lado:DatingModel ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:decimal .

lado:withheldBecause a owl:DatatypeProperty ;
    rdfs:label "withheld because"@en ;
    rdfs:comment "Die Begruendung fuer die Zurueckhaltung, im Klartext."@de,
        "Why a terminus was withheld from the criterion, in plain words, so that the judgement can be disagreed with rather than merely obeyed."@en ;
    rdfs:domain lado:IndependentTerminus ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:string .

lado:withheldFromCriterion a owl:DatatypeProperty ;
    rdfs:label "withheld from criterion"@en ;
    rdfs:comment "Wahr, wenn dieser Termin in den Abbildungen erscheint, aber nicht in das Kalibrierungskriterium eingeht. Ein bestrittener Termin darf keinen publizierten Parameter setzen; ihn ganz wegzulassen wuerde verbergen, dass er je ein Kandidat war."@de,
        "True where a terminus appears in the figures but was kept out of the calibration criterion. A contested date should not set a published parameter; dropping it altogether would hide that it was ever a candidate and why. The accompanying reason says which is the case here."@en ;
    rdfs:domain lado:IndependentTerminus ;
    rdfs:isDefinedBy <http://archaeology.link/ontology> ;
    rdfs:range xsd:boolean .

samian:bundle_IPSDatedSites a void:Dataset,
        crm:E73_Information_Object,
        crmdig:D1_Digital_Object,
        dcat:Dataset ;
    dcterms:description "Self-contained bundle: the findspot datings, the full LADO vocabulary, and rdf:type triples materialised over rdfs:subClassOf so that CIDOC CRM and OWL-Time queries resolve without a reasoner. Loadable into a triplestore on its own."@en ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:license <https://spdx.org/licenses/MIT.html> ;
    dcterms:source "Samian Research / IPS. Rights in the source data are held by the database publishers and are independent of the MIT licence covering the software that produced this file."@en ;
    dcterms:title "IPS dated sites — data, vocabulary and materialised CRM crosswalk"@en ;
    void:classPartition <http://data.archaeology.link/data/samian/bundle_IPSDatedSites/stat_activities>,
        <http://data.archaeology.link/data/samian/bundle_IPSDatedSites/stat_cidoc>,
        <http://data.archaeology.link/data/samian/bundle_IPSDatedSites/stat_datings>,
        <http://data.archaeology.link/data/samian/bundle_IPSDatedSites/stat_findspots>,
        <http://data.archaeology.link/data/samian/bundle_IPSDatedSites/stat_owl-time>,
        <http://data.archaeology.link/data/samian/bundle_IPSDatedSites/stat_plot>,
        <http://data.archaeology.link/data/samian/bundle_IPSDatedSites/stat_sites> ;
    rdfs:comment "700 rdf:type triples in this file are inferred rather than asserted: they are the transitive closure over rdfs:subClassOf, written out explicitly. The axioms they follow from are included, so a reasoning store derives nothing new."@en ;
    owl:versionInfo "2026-08-28" .

