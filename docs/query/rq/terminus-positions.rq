# Every dating against every fixed point
# The whole 41 by 5 grid, counted. Each dating ends before an independent
# terminus, contains it, or begins after it. Because a terminus is an instant
# and not an interval, these are OWL-Time's own <code>time:before</code>,
# <code>time:inside</code> and <code>time:after</code> rather than Allen
# relations, which hold only between proper intervals. The shape of the table
# is a sanity check on the corpus: a terminus near the start should have
# almost nothing before it, one near the end almost nothing after it.

PREFIX samian:  <http://data.archaeology.link/data/samian/>
PREFIX lado:    <http://archaeology.link/ontology#>
PREFIX crm:     <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crmdig:  <http://www.ics.forth.gr/isl/CRMdig/>
PREFIX time:    <http://www.w3.org/2006/time#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dcat:    <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:     <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

SELECT ?event ?year ?before ?inside ?after WHERE {
  {
    SELECT ?ev
           (SUM(IF(?rel = time:before, 1, 0)) AS ?before)
           (SUM(IF(?rel = time:inside, 1, 0)) AS ?inside)
           (SUM(IF(?rel = time:after, 1, 0)) AS ?after)
    WHERE {
      ?ev a lado:IndependentTerminus ; crm:P4_has_time-span ?tsp .
      ?ts ?rel ?tsp .
      FILTER(?rel IN (time:before, time:inside, time:after))
    }
    GROUP BY ?ev
  }
  ?ev rdfs:label ?event ;
      crm:P4_has_time-span/time:inTimePosition/time:numericPosition
        ?year .
}
ORDER BY ?year
