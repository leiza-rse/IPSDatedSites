# Why an order stops holding
# The pairs that are ordered on the modelled intervals but not once the
# evidence is read generously. The columns are the bounds the relation is
# actually computed from, and the gap between them — sorted with the narrowest
# first, because those are the claims that fail soonest. Read the last two
# columns beside it: the modelled intervals are a year apart while the
# potters' date ranges overlap by decades. That is the whole distinction in
# one line, and it is why these pairs carry <code>lado:possiblyBefore</code>
# and not <code>time:intervalBefore</code>.

PREFIX samian:  <http://data.archaeology.link/data/samian/>
PREFIX lado:    <http://archaeology.link/ontology#>
PREFIX crm:     <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crmdig:  <http://www.ics.forth.gr/isl/CRMdig/>
PREFIX time:    <http://www.w3.org/2006/time#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dcat:    <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:     <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

SELECT ?earlier ?ends ?later ?begins ?gap ?evidenceEndsA ?evidenceBeginsB
WHERE {
  ?tsA lado:possiblyBefore ?tsB .
  FILTER NOT EXISTS { ?tsA time:intervalBefore ?tsB }
  ?fsA crm:P4_has_time-span ?tsA ; rdfs:label ?earlier .
  ?fsB crm:P4_has_time-span ?tsB ; rdfs:label ?later .
  ?tsA time:hasEnd/time:inTimePosition/time:numericPosition ?ends ;
       lado:maxDatemax ?evidenceEndsA .
  ?tsB time:hasBeginning/time:inTimePosition/time:numericPosition ?begins ;
       lado:minDatemin ?evidenceBeginsB .
  BIND(ROUND(?begins - ?ends) AS ?gap)
}
ORDER BY ?gap
LIMIT 25
